{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independently pinned public original packets, not a census",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packets"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_id",
          "directory",
          "source_revision",
          "request_sha256",
          "capture_sha256",
          "allowed_hosts",
          "known_census_gaps"
        ],
        "properties": {
          "packet_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,95}$"
          },
          "directory": {
            "type": "string",
            "pattern": "^source-packets/[a-z][a-z0-9-]{0,95}$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capture_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "allowed_hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "known_census_gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
