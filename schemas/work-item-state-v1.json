{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/au-health-policy-atlas/work-item-state-v1.schema.json",
  "title": "Atlas Work Item State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "work_item_id",
    "stage",
    "status",
    "attempt",
    "input_hashes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "census",
        "bronze",
        "silver",
        "gold",
        "platinum",
        "gap-analysis"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "evidence_ready",
        "candidate",
        "verified",
        "supported",
        "provisional",
        "abstained",
        "failed"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
